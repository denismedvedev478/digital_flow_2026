    puts "\033\]2;[file tail $::env(PWD)] - [get_db current_design .name] \
        - [set STAGE "prePlace"] [clock format [clock seconds] -format "%R     %d / %m / %C%y"]\a"
        
    delete_buffer_trees

    # ------------------
