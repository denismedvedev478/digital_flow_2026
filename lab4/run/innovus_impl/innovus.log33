    time_design -pre_cts -report_only -expanded_views -report_dir ./reports/R.${STAGE} -report_prefix R.${STAGE} -hold

    user_reports

    # write db 
    write_db ./db/DB.$::env(ENV_DESIGN).${STAGE}.enc

}
