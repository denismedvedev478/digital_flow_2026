@file 187: proc user_preplace {args} \
{
    
    #                       _                
    #  _ __  _ __ ___ _ __ | | __ _  ___ ___ 
    # | '_ \| '__/ _ \ '_ \| |/ _` |/ __/ _ \
    # | |_) | | |  __/ |_) | | (_| | (_|  __/
