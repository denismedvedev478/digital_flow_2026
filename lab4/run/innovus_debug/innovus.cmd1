check_place
check_connectivity \
    -type all \
    -out_file ${eco_report_dir}/connectivity.rpt
check_drc \
    -check_only all \
    -out_file ${eco_report_dir}/drc.rpt
reset_parasitics
extract_rc
report_timing -late -path_type full_clock -max_paths 1 -group reg2reg
report_timing -early -path_type full_clock -max_paths 1 -group reg2reg
